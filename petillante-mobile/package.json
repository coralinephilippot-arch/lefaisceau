{
  "name": "petillante-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Pétillante — applications iOS et Android (Capacitor) construites à partir de ../petillante",
  "license": "UNLICENSED",
  "scripts": {
    "web": "node scripts/copy-web.mjs",
    "sync": "npm run web && cap sync",
    "assets": "capacitor-assets generate --iconBackgroundColor '#FF5B3A' --iconBackgroundColorDark '#FF5B3A' --splashBackgroundColor '#F7F0E6' --splashBackgroundColorDark '#1A1224'",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
